<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Stage 1 Report </title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <style>
        .row-container {
            width: auto;
            padding: 10px;
            background-color: transparent;
            display: flex;
        }

        .row-container div {
            padding: 10px;
        }

        .fade {
            opacity: 1;
            /* Ensure the fade container is visible */
            transition: opacity 0.5s;
            /* Optional: for fade effect */
        }

        .gradient-text {
            font-size: 1em;
            /* Adjust size as needed */
            background: -webkit-linear-gradient(rgb(0, 0, 0), rgba(86, 118, 235, 0));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            /* Ensures the element takes up space */
        }

        canvas {
            max-width: 600px;
            width: 100%;
        }
    </style>

</head>



<body>

    <script>
        function decodeHtml(html) {
            const textArea = document.createElement('textarea');
            textArea.innerHTML = html;
            return textArea.value;
        }
    </script>
    
    <nav id="newnav"></nav>
    <div class="sep-bar-10"></div>

    <div class="main-container">
        <div class="grid-container">
            <h4> 評述員</h4>
            <div>
                <%= coachname %>
            </div>
        </div>
        <div class="grid-container">
            <h4> 影片上載如期</h4>
            <div>
                <%= purchase.date %>
            </div>
        </div>
    </div>


    <div id="stage1" class="block-container" style="margin-left: 20px;">
        <h1> 整體評價 </h1>
    </div>

    <div class="fullwidth-container">
        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div id="msg1" style="display:none" aria-hidden="true"><%=purchase.stage["1"].message %></div>
                <div id="msgbox1" class="content-container"></div>
            </div>
            <script>
                const encodedHtml1 = $("#msg1").html();
                const decodedHtml1 = decodeHtml(encodedHtml1);
                document.getElementById('msgbox1').innerHTML = decodedHtml1;
            </script>
            
            <div class="col-md-6 col-sm-12">
                <div class="content-container">
                    <canvas id="myRadarChart1"></canvas>
                    <input id="data1" type="hidden" value="<%= purchase.stage["1"].data[0] %>">
                </div>
            </div>
        </div>

    </div>

    <button type="button" id="goToRegister" class="btn btn-primary" data-bs-toggle="modal"
            data-bs-target="#registerModal" style="display:none"></button>

        <div class="modal fade" id="registerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
            aria-labelledby="staticBackdropLabel" aria-hidden="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="staticBackdropLabel">溫馨小提示</h5>
                    </div>
                    <div class="modal-body">
                        Minnie為你寫的報告，是讓你有多一雙專業的眼睛去分析自己！你可以和自己的教練討論，但切記要尊重自己教練的意見喔！
                    </div>
                    <div class="modal-footer">
                        <button id="close" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal" style="background-color: #D1B000; color: white">知道了</button>
                    </div>
                </div>
            </div>
        </div>

    <div id="stage2" class="block-container" style="margin-left: 20px;">
        <h1> 技術建議 </h1>
    </div>
    <% if (purchase.stage["2"].status=="locked" ) { %>
        <div class="fullwidth-container">
            <div class="grid-container">
                <div class="unlock"> 技術建議需解鎖下一階段。</div>
            </div>
            <div class="sep-bar-10"></div>
            <div class="row-container">
                <div><button class="mybtn-grid" onclick="goToPurchase()"> 解鎖下一階段</button></div>
                <div><button id="showPreview2" class="mybtn-grid" onclick="showPreview(this.id)"> 按此預覽 </button></div>
            </div>

            <div id="preview2" class="grid-container" style="display:none">
                <% const partOfString2=purchase.stage["2"].message.slice(0,100) %>
                    <div class="gradient-text">
                        <%= partOfString2 %>
                    </div>
            </div>
        </div>
        <% } else { %>
            <div class="fullwidth-container">
                <div class="row">
                    <!-- <div class="col-md-6 col-sm-12">
                        <div class="content-container">
                            <%= purchase.stage["2"].message %>
                        </div>
                    </div> -->
                <div class="col-md-6 col-sm-12">
                    <div id="msg2" style="display:none" aria-hidden="true"><%=purchase.stage["2"].message %></div>
                    <div id="msgbox2" class="content-container"></div>
                </div>
                <script>
                    const encodedHtml2 = $("#msg2").html();
                    const decodedHtml2 = decodeHtml(encodedHtml2);
                    document.getElementById('msgbox2').innerHTML = decodedHtml2;
                </script>
                    <div class="col-md-6 col-sm-12">
                        <div class="content-container">
                            <canvas id="myRadarChart2"></canvas>
                            <input id="data2" type="hidden" value="<%= purchase.stage["2"].data[0] %>">
                        </div>
                    </div>
                </div>

            </div>
            <% } %>



                <div id="stage3" class="block-container" style="margin-left: 20px;">
                    <h1> 訓練計畫建議 </h1>
                </div>
                <% if (purchase.stage["3"].status=="locked" ) { %>
                    <div class="fullwidth-container">
                        <div class="row-container">
                            <div class="unlock"> 訓練計畫建議需解鎖下一階段。</div>
                        </div>
                        <div class="sep-bar-10"></div>
                        <div class="row-container">
                            <div><button class="mybtn-grid" onclick="goToPurchase()"> 解鎖下一階段</button></div>
                            <div><button id="showPreview3" class="mybtn-grid" onclick="showPreview(this.id)">
                                    按此預覽</button></div>
                        </div>

                        <div id="preview3" class="grid-container" style="display:none">
                            <% const partOfString3=purchase.stage["3"].message.slice(0,100);
                                console.log(partOfString3)%>
                                <div class="gradient-text">
                                    <%= partOfString3 %>
                                </div>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="fullwidth-container">
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <div id="msg3" style="display:none" aria-hidden="true"><%=purchase.stage["3"].message %></div>
                                    <div id="msgbox3" class="content-container"></div>
                                </div>
                    <script>
                        const encodedHtml3 = $("#msg3").html();
                        const decodedHtml3 = decodeHtml(encodedHtml3);
                        document.getElementById('msgbox3').innerHTML = decodedHtml3;
                    </script>
                                <div class="col-md-6 col-sm-12">
                                    <div class="content-container">
                                        <canvas id="myRadarChart3"></canvas>
                                        <input id="data3" type="hidden" value="<%= purchase.stage["3"].data[0] %>">
                                    </div>
                                </div>
                            </div>
                            <% } %>
                    </div>

                                <input id="label1" style="display:none" value="<%= purchase.stage["1"].data[1] %>">
                                <input id="label2" style="display:none" value="<%= purchase.stage["2"].data[1] %>">
                                <input id="label3" style="display:none" value="<%= purchase.stage["3"].data[1] %>">

                    <div class="content-container">
                        <button onclick="gototop()"> 回到置頂</button>
                        <div class="sep-bar-10"></div>
                        <button onclick="history.back()"> 返回</button>
                    </div>




            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                const hexalabel1 = $('#label1').val()
                const hexalabel2 = $('#label2').val()
                const hexalabel3 = $('#label3').val()
                const labelarr1 = hexalabel1.split(',')
                const labelarr2 = hexalabel2.split(',')
                const labelarr3 = hexalabel3.split(',')

                const hexadata1 = $('#data1').val();
                var data_array1 = hexadata1.split(',').map(function (item) {
                    return parseFloat(item, 10)
                });

            

                const ctx1 = document.getElementById('myRadarChart1').getContext('2d');
                const myRadarChart1 = new Chart(ctx1, {
                    type: 'radar',
                    data: {
                        labels: labelarr1,
                        datasets: [{
                            label: '綜合能力評估',
                            data: data_array1,
                            backgroundColor: 'rgba(255, 99, 132, 0.2)',
                            borderColor: 'rgba(255, 99, 132, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        scale: {
                            r: {
                                beginAtZero: true,
                                min: 0,
                                max: 5.0
                            }
                        }
                    }
                });

                if ($('#data2').val()) {
                    const hexadata2 = $('#data2').val();
                    var data_array2 = hexadata2.split(',').map(function (item) {
                        return parseFloat(item, 10)
                    });

                    const ctx2 = document.getElementById('myRadarChart2').getContext('2d');
                    const myRadarChart2 = new Chart(ctx2, {
                        type: 'radar',
                        data: {
                            labels: labelarr2,
                            datasets: [{
                                label: '技術評估',
                                data: data_array2,
                                backgroundColor: 'rgba(155, 160, 252, 0.2)',
                                borderColor: 'rgba(155, 160, 252, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            scale: {
                                r: {
                                    beginAtZero: true,
                                    min: 0,
                                    max: 5.0
                                }
                            }
                        }
                    });
                }

                if ($('#data3').val()) {

                    const hexadata3 = $('#data3').val();
                    var data_array3 = hexadata3.split(',').map(function (item) {
                        return parseFloat(item, 10)
                    });

                    const ctx3 = document.getElementById('myRadarChart3').getContext('2d');
                    const myRadarChart3 = new Chart(ctx3, {
                        type: 'radar',
                        data: {
                            labels: labelarr3,
                            datasets: [{
                                label: '現階段需著重的訓練',
                                data: data_array3,
                                backgroundColor: 'rgba(20, 150, 200, 0.2)',
                                borderColor: 'rgba(20, 150, 200, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            scale: {
                                r: {
                                    beginAtZero: true,
                                    min: 0,
                                    max: 5.0
                                }
                            }
                        }
                    });
                }

            </script>





            <script>

            document.addEventListener('DOMContentLoaded', function() {
                    $('#goToRegister').click();
            })


                function showPreview(id) {
                    const idx = id[id.length - 1]
                    console.log(idx)
                    const previewid = "#preview" + String(idx)
                    console.log(previewid)
                    const previewtext = $(previewid);
                    console.log(previewtext)

                    previewtext.toggle()
                }

                function goToPurchase() {
                    window.location.href = "/students/purchase"
                }
            </script>

            <script src="/js/utilbtn.js"></script>
            <script
                src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
                crossorigin="anonymous"></script>
            <script src="/js/new_navbar.js"></script>

</body>

</html>