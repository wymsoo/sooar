<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Write Report</title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <style>
        .fullwidth-container-no-border {
            display: grid;
            padding: 10px;
            margin: 20px;
        }

        .toolbar {
            border: 1px solid #ccc;
            padding: 10px;
            background: #f9f9f9;
            width: 690px;
        }
        #editor {
            border: 1px solid #7e7e7e;
            min-height: 200px;
            padding: 10px;
            margin-top: 10px;
            background: #fff;
            width: 690px;
            height: 606px;
            overflow: scroll;
        }

        .font-btn.toggle-active {
            background-color: #D1B000; /* Change color when active */
            color: white; /* Text color when active */
        }

        .font-btn {
            height: 30px;
            width: 30px;
            border-radius: 50%;
            background-color: #DA7B93;
            color: white;
        }

    </style>
</head>

<body>
    <script>
        function decodeHtml(html) {
            const textArea = document.createElement('textarea');
            textArea.innerHTML = html;
            return textArea.value;
    }
    </script>
    <nav id="newnav"></nav>
    <div class="sep-line"></div>
    <div class="sep-bar-10"></div>

    <div class="fullwidth-container">
        <h2>球員資料</h2>
        <div>球員：<%= student.fullname %>
        </div>
        <div>訂單編號：<%= purchaseid %>
        </div>
        <div>訂單日期：<%= purchasedate %>
        </div>
        <div>球員問題：<%= purchase.info.studentQuestion %></div>
        <div class="sep-bar-10"></div>
    </div>

    <div class="fullwidth-container-no-border">
        <form id="writtenReport" action="/instructors/uploadReport?user=<%= userid %>&purchaseid=<%= purchaseid %>&purchasedate=<%= purchasedate %>&stage1=<%= stage1 %>&stage2=<%= stage2 %>&stage3=<%= stage3 %>" method="POST">
            <% console.log(report[1].data)
                if (report[1].data[1]=='') { %>
                <h4> 綜合能力評估 </h4><input style="width: 100%" name="hexalabel1" value="進攻力,防禦力,膽量,落點意識,搶攻意識,相持能力">
            <% } else { %>
                <h4> 綜合能力評估 </h4><input style="width: 100%" name="hexalabel1" value="<%= report[1].data[1] %>">
            <% } %>
            <input name="hexadata1" style="width: 100%" value="<%= report[1].data[0] %>">
            <div class="sep-bar-10"></div>
            <div class="sep-bar-10"></div>

            <% if (report[2].data[1]=='') { %>
            <h4> 技術能力評估 </h4><input style="width: 100%" name="hexalabel2" value="正手上旋,反手上旋,正手下旋,反手下旋,發球,接發球">
            <% } else { %>
            <h4> 技術能力評估 </h4><input style="width: 100%" name="hexalabel2" value="<%= report[2].data[1] %>" >
            <% } %>
            <input name="hexadata2" style="width: 100%" value="<%= report[2].data[0] %>">
            <div class="sep-bar-10"></div>
            <div class="sep-bar-10"></div>

            <% if (report[3].data[1]=='') { %>
            <h4> 應提升範疇 </h4><input style="width: 100%" name="hexalabel3" value="步法,基本功,前三板戰術,體能,心態">
            <% } else { %>
                <h4> 應提升範疇 </h4><input style="width: 100%" name="hexalabel3" value="<%= report[3].data[1] %>">
            <% } %>
            <input name="hexadata3" style="width: 100%" value="<%= report[3].data[0] %>">
            <div class="sep-bar-10"></div>
            <div class="sep-bar-10"></div>

            <h4> 整體評價</h4>

            <div class="toolbar">
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('bold')">B</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('italic')">I</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('underline')">U</button>
            </div>
            <div id="msg1" style="display:none" aria-hidden="true"><%=report[1].message %></div>
            <div id="editor1" contenteditable="true" name="message1" style="width: 690px; height: 606px"><%= report[1].message %></div>
                <script>
                    const encodedHtml1 = $("#msg1").html();
                    const decodedHtml1 = decodeHtml(encodedHtml1);
                    document.getElementById('editor1').innerHTML = decodedHtml1;
                </script>
            <input type="hidden" name="message1" id="hiddenMessage1">



            <h4> 技術評價</h4>
            <!-- <textarea name="message2" cols="80" rows="25"><%= report[2].message %></textarea> -->
            <div class="toolbar">
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('bold')">B</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('italic')">I</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('underline')">U</button>
            </div>
            <div id="msg2" style="display:none" aria-hidden="true"><%=report[2].message %></div>
            <div id="editor2" contenteditable="true" name="message2" style="width: 690px; height: 606px"><%= report[2].message %></div>
                <script>
                    const encodedHtml2 = $("#msg2").html();
                    const decodedHtml2 = decodeHtml(encodedHtml2);
                    document.getElementById('editor2').innerHTML = decodedHtml2;
                </script>
            <input type="hidden" name="message2" id="hiddenMessage2">



            <h4> 訓練計畫建議</h4>
            <!-- <textarea name="message3" cols="80" rows="25"><%= report[3].message %></textarea> -->
            <div class="toolbar">
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('bold')">B</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('italic')">I</button>
            <button class="font-btn" type="button" onclick="toggleButton(this);document.execCommand('underline')">U</button>
            </div>
            <div id="msg3" style="display:none" aria-hidden="true"><%=report[3].message %></div>
            <div id="editor3" contenteditable="true" name="message3" style="width: 690px; height: 606px"><%= report[3].message %></div>
                <script>
                    const encodedHtml3 = $("#msg3").html();
                    const decodedHtml3 = decodeHtml(encodedHtml3);
                    document.getElementById('editor3').innerHTML = decodedHtml3;
                </script>
            <input type="hidden" name="message3" id="hiddenMessage3">

            <div class="sep-bar-10"></div>
            <input type="submit" id="upload" class="mybtn" style="width:100vw" value="上傳">
            <div class="sep-bar-10"></div>
            <div class="sep-bar-10"></div>
            <input type="submit" class="mybtn" style="width:100vw; background-color: grey" formaction="/instructors/saveReport?user=<%= userid %>&purchaseid=<%= purchaseid %>&purchasedate=<%= purchasedate %>&stage1=<%= stage1 %>&stage2=<%= stage2 %>&stage3=<%= stage3 %>" formmethod="POST"
                value="保存">
        </form>
    </div>

    <script>


        function toggleButton(btn){
            btn.classList.toggle('toggle-active');
        }
        document.getElementById('writtenReport').onsubmit = function() {
            const editorContent1 = document.getElementById('editor1').innerHTML;
            document.getElementById('hiddenMessage1').value = editorContent1;
            const editorContent2 = document.getElementById('editor2').innerHTML;
            document.getElementById('hiddenMessage2').value = editorContent2;
            const editorContent3 = document.getElementById('editor3').innerHTML;
            document.getElementById('hiddenMessage3').value = editorContent3;
        };</script>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
    <script src="/js/new_navbar.js"></script>
</body>

</html>