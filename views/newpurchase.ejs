<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> New Purchase </title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link rel="stylesheet" href="../css/soarerbtn.css">
    <link rel="stylesheet" href="../css/popup_chat.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://js.stripe.com/basil/stripe.js"></script>



    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <style>
        form div {
            width: 80%
        }
    </style>
</head>

<body>

    <div id="newnav"></div>
    <div class="sep-bar-10"></div>
    <div id="popup_chat" style="display: none"></div>
    <div class="outer-circle animate bounce">
        <button class="inner-circle" onclick="gotochat()"></button>
    </div>
    <div class="block-container" style="margin-left: 20px; width: 90vw">
        <div>
            <div class="sep-bar-10"></div>
            <h1> 購買顧問服務</h1>
            <div class="unlock">
                *所有服務均需要提供比賽影片，讓導師作分析用途。閣下需在表格提供付費證明（截圖）。提交表格後，公司將將於5小時內確認訂單，確認訂單後你會在whatsapp收到通知。報告會在確認訂單後的5天內完成。</div>
        </div>
    </div>

    <div class="content-container">
        <div> 選擇導師 </div>
        <div class="sep-bar-10"></div>
        <select>
            <% coachlist.forEach((coach)=> { %>
                <option value=<%=coach.username %>> <%= coach.nickname %>
                </option>
                <% }) %>
        </select>
    </div>

    <div id="newPurchaseForm" style="border: 2px solid black; border-radius: 5px; margin: 10px">
        <div class="content-container">
            <div style="display:flex; justify-content: space-between;">
                <div>
                    <h3>你的訂單</h3>
                </div>
                <!-- <div><button style="width:30px" onclick="toggleForm()">X</button></div> -->
            </div>
            <div class="sep-bar-10"></div>
            <div class="unlock"> 留意：請核對你所購入的服務編碼是否準確。</div>
            <div class="sep-bar-10"></div>

            <div id="registerInPurchase" class="content-container" style="display:none">
                <div>
                    <h4>你的個人資料</h4>
                </div>
                <div class="sep-bar-10"></div>
                <label style="color:grey;">學員全名<span class="text-danger">*</span></label>
                <input id="name" placeholder="Full Name" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">學員暱稱</label>
                <input id="nickname" placeholder="Nickname/ Preferred to be called as">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">出生年份<span class="text-danger">*</span></label>
                <input id="dob" placeholder="yyyy" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">聯絡電話<span class="text-danger">*</span></label>
                <input id="studentphone" placeholder="studentphone" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">電郵<span class="text-danger">*</span></label>
                <div class="main-container">
                    <input id="username" type="text" class="form-control" placeholder="e.g.johnchan123"
                        aria-label="Username" required>
                    <span class="input-group-text">@</span>
                    <input id="email" type="text" class="form-control" placeholder="gmail.com" aria-label="Email"
                        required>
                </div>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">其他聯絡方式</label>
                <input id="otherContact" placeholder="e.g. WeChat: john24chan">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">喜好聯絡方式<span class="text-danger">*</span></label>
                <input id="contactMethod" placeholder="e.g. Whatsapp">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">密碼<span class="text-danger">*</span></label>
                <input type="password" id="password" class="login-input" placeholder="Password" required>


                <label style="color:grey;">確認密碼<span class="text-danger">*</span></label>
                <input type="password" id="reconfirmpassword" placeholder="Password" required>
                <div class="sep-bar-10"></div>


            </div>


            <form>

                <label for="selectedCoach">1. 導師<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div>
                    <select id="selectedCoach" style="width: 100%" required>
                        <% coachlist.forEach((coach)=> { %>
                            <option value=<%=coach.username %>> <%= coach.nickname %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <label for="productname">2. 訂購服務<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div><select id="productname" style="width: 100%" required>
                        <option value="U001"> 綜合報告(#U001) $859</option>
                        <option value="UF01"> 綜合報告+面談(#UF01) $1199</option>
                        <option value="S001"> 整體評價(#S001) $299</option>
                        <!-- <option value="CV01"> 旁述影片(#CV01) $399</option> -->
                    </select>
                </div>

                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <label for="matchVideo"> 3. 上傳比賽影片<span class="text-danger">*</span></label>
                <button type="button" id="fullMatchInput-btn"style="border-radius: 30px; padding: 5px; text-align: center; background-color: rgb(101, 132, 162); color: white; font-size: 0.8em;" onclick="toggleVideoInput(this.id)">上載全場比賽</button>
                <button type="button" id="gameInput-btn" style="border-radius: 30px; padding: 5px; text-align: center; background-color: rgb(101, 132, 162); color: white; font-size: 0.8em;" onclick="toggleVideoInput(this.id)">逐局上載</button>

                <div id="fullMatchInput"  class="inactive-btn" style="display: none">
                    <div class="sep-bar-10"></div>
                    <label>全場比賽</label><input type="file" id="fullMatch" name="matchVideo" accept="video/*" style="width: 100%">
                </div>
                <div id="gameInput"  class="inactive-btn" style="display: none">
                    <div class="sep-bar-10"></div>
                    <label>第一局</label><input type="file" id="game1" name="matchVideo" accept="video/*" style="width: 100%">
                    <label>第二局</label><input type="file" id="game2" name="matchVideo" accept="video/*" style="width: 100%">
                    <label>第三局</label><input type="file" id="game3" name="matchVideo" accept="video/*" style="width: 100%">
                    <label>第四局</label><input type="file" id="game4" name="matchVideo" accept="video/*" style="width: 100%">
                    <label>第五局</label><input type="file" id="game5" name="matchVideo" accept="video/*" style="width: 100%">
                </div>

                <div class="sep-bar-10"></div>
                <label for="questions"> 3. 2-3條想問導師的問題<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div>
                    <button
                        style="border-radius: 30px; padding: 5px; text-align: center; background-color: rgb(101, 132, 162); color: white; font-size: 0.8em;"
                         type="button" data-bs-toggle="modal"
                        data-bs-target="#questionModal">不知道問什麼？</button>
                    <div class="sep-bar-10"></div>
                    <textarea type="text" id="questions" name="questions" style="width: 100%; height: 200px"
                        placeholder="1. 請問如何在關鍵球時有更穩定的發揮？" required></textarea>

                </div>

                <div class="sep-bar-10"></div>
                <label for="paymentmethod"> 4. 付款方式<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div><select id="paymentmethod" style="width: 100%" required>
                        <option value="single"> FPS </option>
                        <option value="set2"> Payme </option>
                        <option value="set3"> Alipay HK</option>
                    </select>
                </div>

                <div class="sep-bar-10"></div>
                <button class="mybtn-grid" onclick="initOrder(event)"> 購買 </button>
                <div class="sep-bar-10"></div>
                <div id="loading-msg" class="unlock" style="display:none"> Please wait, your purchase is processing...
                </div>
            </form>


            <div id="checkout"></div>

        </div>
    </div>


    <button type="button" id="loading" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop"
        style="display:none"></button>

    <!-- Modal for loading -->
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">處理中...</h5>
                </div>
                <div class="modal-body">
                    我們正在處理您的訂單，請稍候... 請不要離開頁面。
                </div>
                <div class="modal-footer">
                    <button id="close" type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        style="display:none">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Asking user to register-->
    <!-- Button trigger modal -->
    <button type="button" id="goToRegister" class="btn btn-primary" data-bs-toggle="modal"
        data-bs-target="#registerModal" style="display:none"></button>

    <div class="modal fade" id="registerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">第一次購買顧問服務？</h5>
                </div>
                <div class="modal-body">
                    你是第一次購買顧問服務嗎？若果是第一次，我們會自動幫你註冊。若果你曾經購買過任何服務，你已經是我們的一份子了！請登入，讓我們為你更貼心地服務。
                </div>
                <div class="modal-footer">
                    <button id="loginnow" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        onclick="loginNow()">登入</button>
                    <button id="close" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        style="background-color: #D1B000; color: white">第一次購買</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="questionModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">我可以問導師什麼類型的問題？</h5>
                </div>
                <div class="modal-body">
                    <div>
                        以下是一些問題的例子，供大家參考：<br>
                        1.
                        <b>技戰術類型</b>：我這場覺得自己很上風，總在進攻，為何最後會輸？我覺得他的發球太難接了！到底如何解決？我練習時總是練正手，但比賽有很多失誤，到底是為什麼？我是不是打球太兇狠？<br><br>
                        2. <b>心態類型</b>：為什麼我每次關鍵球都贏不下來？我覺得我比賽很緊張，如何可以解決？我每次領先都會走神，然後倒輸，怎麼辦？<br><br>
                        3. <b>迷茫類型</b>：我不知道自己場上打了些什麼，就輸了。（別覺得不好意思，這是專業運動員也常出現的情況。）你認為我打得好嗎？怎麼可以更好？<br><br>
                        4. <b>發洩類型</b>：我覺得自己太差了，什麼都差，不知道如何說起。（別覺得不好意思，專業運動員也會覺得迷茫和心灰意冷。）我真的很討厭削球手！<br>
                    </div>
                    <div class="main-container">
                        <div>
                            <img src="/images/soarer_cheer.jpg" style="height:200px; width:auto; max-width: 200px">
                        </div>

                        <div><div class="main-container" style="border: 1px solid grey; border-radius: 10px; padding: 20px;">
                            不用害羞喔，發現問題，就已經解決問題的一半了！</div></div>

                    </div>
                    <div class="modal-footer">
                        <button id="close" type="button" class="mybtn-grid" data-bs-dismiss="modal"
                            style="background-color: #D1B000; color: white">關閉</button>
                    </div>
                </div>
            </div>
        </div>
    </div>





    <script>

        function toggleVideoInput(id){
            
            const split = id.split('-')
            const ele = document.getElementById(split[0]);
            console.log(ele)
            ele.style.display = 'block';
            ele.classList.replace('inactive-btn', 'active-btn')
            if (ele.id == "fullMatchInput"){
                $('#gameInput-btn').css('background-color','rgb(101, 132, 162)')
                $('#fullMatchInput-btn').css('background-color','#DA7B93')
                document.getElementById('gameInput').style.display = 'none';
                document.getElementById('gameInput').classList.replace('active-btn','inactive-btn');}
            else {
                $('#fullMatchInput-btn').css('background-color','rgb(101, 132, 162)')
                $('#gameInput-btn').css('background-color','#DA7B93')
                document.getElementById('fullMatchInput').style.display = 'none'
                document.getElementById('fullMatchInput').classList.replace('active-btn','inactive-btn');}

            }
        

        function loginNow() {
            window.location.href = "/html/login.html"
        }


        function toggleForm() {
            $('#newPurchaseForm').hide();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var loginStatus = sessionStorage.getItem("login-status");
            if (loginStatus != 'true') {
                $('#registerInPurchase').show();
                $('#goToRegister').click();
                window.scrollTo(0, 0);
            } else {
                $('#newPurchaseForm').show();
            }
        })



        /* register function */
        function registerNewUser() {
            const email = $('#username').val() + '@' + $('#email').val();
            if ($('#password').val() != $('#reconfirmpassword').val()) {
                alert("Please reconfirm your pasword.");
                return false;
            }
            const data = {
                username: $('#username').val(),
                password: $('#password').val(),
                fullname: $('#name').val(),
                nickname: $('#nickname').val() || $('#name').val(),
                dob: $('#dob').val(),
                phone: $('#studentphone').val(),
                email: email,
                contactMethod: $('#contactMethod').val()
            };

            console.log(data);
            fetch('/auth/register', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => (res.json())).then(
                (data) => {
                    if (data.success) {
                        return true
                    } else {
                        alert(data.message);
                        throw new Error(data.message);
                    }
                }
            )
        };

        // end of register function 


        // login function
        function autoLogin() {
            const data = {
                username: $('#username').val(),
                password: $('#password').val()
            };
            fetch('/auth/login', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((login) => {
                if (login.status) {
                    sessionStorage.setItem('username', data.username);
                    sessionStorage.setItem('login-status', true);
                    if (sessionStorage.getItem('login-status') == 'true') {
                        sessionStorage.setItem('role', login.role);
                        return true
                    }
                } else {
                    alert(login.message);
                }
            }).catch((error) => console.error(error))
        }
        // end of login function
        const stripe = Stripe('pk_test_51RlO80Pw6VRYu2WWJGmuAUIhG3IOPvBvj4BJQExdVcwUuyDbkYyucHukg5mUq3qFnHeqT86rkA5kVr8TBWy9OSBh00tdKAff4o');


        // append a new purchase object to purchase array
        async function initOrder(e) {

            const fileInput = document.querySelector('input[type="file"]');
            console.log(fileInput)
            if (fileInput==null) {
                alert("Please upload a match video.");
                return;
            }
            e.preventDefault();
            $(this).attr("disabled", "disabled");
            $('#loading').click();
            $('#loading-msg').show();

            if (sessionStorage.getItem('login-status') != 'true') {
                if (await registerNewUser()) {
                    await autoLogin();
                }
            }

            const purchase = $('#productname').val();
            const instructor = $('#selectedCoach').val();
            const question = $('#questions').val();

            let formdata;
            
            try {
                formdata = new FormData();

                const videoType = $('.active-btn').attr('id');
                console.log(videoType)

                if (videoType === "fullMatchInput") {
                    var input = document.getElementById('fullMatch');
                    if (input && input.files.length > 0) {
                        formdata.append('files', input.files[0])}; 
                } else if (videoType == "gameInput") {
                    const fileIDs = ['game1', 'game2', 'game3', 'game4', 'game5'];
                    fileIDs.forEach((id) => {
                        const fileInput = document.getElementById(id);
                        if (fileInput && fileInput.files.length > 0) {
                            for (let i = 0; i < fileInput.files.length; i++) {
                                formdata.append('files', fileInput.files[i]); 
                            }
                        }
                    });
            }


            formdata.append('purchase', purchase);
            formdata.append('instructor', instructor);
            formdata.append('videoType', videoType);
            formdata.append('question', question);


            const response = await fetch('/purchase/newOrder', {
                method: "POST",
                body: formdata
            });
            const data = await response.json();
            if (data.success == true) {
                console.log(data.purchaseid)
                $('#close').click();
                $('#loading-msg').hide();
                const purchaseresult = await initCheckout(stripe,data.purchaseid);
                    // alert("Sucessfully Purchased.");
                    // return (
                    //     fetch('/mail/send',{
                    //     method: "POST",
                    //     headers: {
                    //         "Content-type": "application/json"
                    //     },
                    //     body: JSON.stringify(emaildata)
                    // })
                    // )
                    }
            else {
                    $('#close').click();
                    $('#loading-msg').hide();
                    alert("Purchase unsuccessful");
                    window.location.href = "/";
                }
            // }).then((res)=>res.json()).then((data)=>{
            //     if (data.success){
            //         alert(data.msg)
            //         window.location.href = "/students/"
            //     }
            } catch(e) {console.error(e)};
        }
    </script>

    <div id="footerHTML"></div>


    <script src="../js/footer.js"></script>
    <script src="../js/new_navbar.js"></script>
    <script src="../js/soarerbtn.js"></script>
    <script src="../js/popup_chat.js"></script>
    <script src="../js/stripecheckout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>


</body>

</html>