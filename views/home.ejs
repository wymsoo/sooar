    <script>

        $(document).ready(() => {
            $('#introModalBtn').click();
        });

        $('#toggleCompanyMoral').on('click', () => {
            $('#companyMoral').show();
            $('#toggleCompanyMoral').hide();
        })

        $('#closeCompanyMoral').on('click', () => {
            $('#toggleCompanyMoral').show();
            $('#companyMoral').hide();
        })



        function askAI() {
            const question = $('#usermessage').val();
            const data = { question };
            const response = $('#convo');
            response[0].insertAdjacentHTML('beforeend',
                `                       <div class="message sent">
                                        ${question}
                                        <span class="metadata">
                                            <span class="time"></span><span class="tick"><svg
                                                    xmlns="http://www.w3.org/2000/svg" width="16" height="15"
                                                    id="msg-dblcheck-ack" x="2063" y="2076">
                                                    <path
                                                        d="M15.01 3.316l-.478-.372a.365.365 0 0 0-.51.063L8.666 9.88a.32.32 0 0 1-.484.032l-.358-.325a.32.32 0 0 0-.484.032l-.378.48a.418.418 0 0 0 .036.54l1.32 1.267a.32.32 0 0 0 .484-.034l6.272-8.048a.366.366 0 0 0-.064-.512zm-4.1 0l-.478-.372a.365.365 0 0 0-.51.063L4.566 9.88a.32.32 0 0 1-.484.032L1.892 7.77a.366.366 0 0 0-.516.005l-.423.433a.364.364 0 0 0 .006.514l3.255 3.185a.32.32 0 0 0 .484-.033l6.272-8.048a.365.365 0 0 0-.063-.51z"
                                                        fill="#4fc3f7" />
                                                </svg></span>
                                        </span>
                                    </div>`)
            response[0].insertAdjacentHTML('beforeend',
                `<div class="message received">
                                        <span style="color: grey; font-style: italic;"> SOARER is typing...</span>
                                        <span class="metadata"><span class="time"></span></span>
                                    </div>`);
            $('#usermessage').val("");
            fetch('/deepseek/askDeepSeek', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((data) => {
                if (data.success) {
                    response.children().last().remove();
                    response[0].insertAdjacentHTML('beforeend',
                        `<div class="message received">
                                        <span>${data.msg}</span>
                                        <span class="metadata"><span class="time"></span></span>
                                    </div>`);
                }
            }).catch((e) => console.error(e))

        }

        function showUserMessage() {
            $('#showmsg').show();
            $('#userinputfield').hide();
            document.getElementById('booknow').style.display = 'flex';
        }

    </script>

