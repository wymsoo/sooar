<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <title> Meeting Requests from Students</title>
</head>

<body>
    <div id="newnav"></div>
    <div class="sep-bar-10"></div>

    <div class="content-container">
        <div class="unlock"> 導師請主動whatsapp或電郵聯絡學員。</div>
    </div>
    <div class="fullwidth-container" style="overflow:scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th> 訂單ID</th>
                    <th> 學員ID </th>
                    <th> 約見日期 </th>
                    <th> 約見時段 </th>
                    <th> 提出時間 </th>
                    <th> 顧問類別 </th>
                    <th> 學員問題 </th>
                    <th> Status</th>
                    <th> Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <% Object.keys(requests).forEach((id)=>{ %>
                        <td> <%= id %></td>
                        <td>
                            <a href="/studentinfo?studentid=<%= requests[id].student %>"><%= requests[id].student %></a>
                        </td>
                        <td>
                            <input id="md-<%= requests[id].student %>-<%= id %>" value="<%= requests[id].meetingdate %>">
                        </td>
                        <td>
                            <%= requests[id].timeslot %>
                        </td>
                        <td>
                            <input id="mt-<%= requests[id].student %>-<%= id %>" value="<%= requests[id].preferred_meeting_time %>">
                        </td>
                        <td>
                            <%= requests[id].consultation_type %>
                        </td>
                        <td><button id="qbtn-<%= requests[id].student %>" class="mybtn-grid"
                                onclick="showStudentQuestions(this.id)">查看</button></td>
                        <td><%= requests[id].resolved %></td>
                        <% if (requests[id].resolved=="unresolved"){ %>
                        <td><button id="confirm-<%= requests[id].student %>-<%= id %>" class="mybtn-grid" style="background-color: rgb(80, 148, 80); color: white" onclick="confirmMeeting(this.id)">約實</button></td>
                        <% } else if (requests[id].resolved=="pending") { %>
                        <td><button id="<%= requests[id].student %>-<%= id %>" class="mybtn-grid" onclick="completeMeeting(this.id)">完成</button></td>
                        <% } else { %>
                        <td><button disabled="true" style="background-color:rgb(188, 187, 187)">已完成</button></td>
                        <% } %>
                    <tr id="q-<%= requests[id].student %>" style="display: none;">
                        <td>
                            <table class="table" style="width: 90vw; overflow: scroll">
                                <tbody>
                                    <tr>
                                        <%= requests[id].description %>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <% }) %>

            </tbody>
        </table>
    </div>

    <div id="footerHTML"></div>

    <script>
        function showStudentQuestions(id) {
            const splitID = id.split('-');
            const studentID = splitID[1]
            $('#q-' + studentID).toggle();
        };
        function completeMeeting(id) {
            const split = id.split('-')
            const meetingid = split[1]
            const student = split[0]
            console.log(meetingid)
            let result = confirm("Do you want to mark this meeting as resolved?");
            if (result){
                fetch(`/instructor/resolveMeeting?meetingid=${meetingid}&student=${student}`)
                .then((res)=>res.json()).then((data)=>{
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert("There's an error.")
                    }
                }).catch((e)=>console.error(e))
            }
        }

        function confirmMeeting(id) {
            const split = id.split('-')
            const meetingid = split[2]
            const student = split[1]
            const gettime = 'mt-'+student+'-'+meetingid
            const getdate = 'md-'+student+'-'+meetingid
            const meetingtime = $(`#${gettime}`).val()
            const meetingdate = $(`#${getdate}`).val()

            console.log(`/instructor/confirmMeeting?meetingid=${meetingid}&student=${student}&meetingTime=${meetingtime}&meetingDate=${meetingdate}`)
            let result = confirm(`Make sure you have confirmed a meeting time with your student before you proceed. Your confirmed date and time is ${meetingdate}, ${meetingtime}.`);
            if (result){
                fetch(`/instructor/confirmMeeting?meetingid=${meetingid}&student=${student}&meetingTime=${meetingtime}&meetingDate=${meetingdate}`)
                .then((res)=>res.json()).then((data)=>{
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert("There's an error.")
                    }
                }).catch((e)=>console.error(e))
            }
        }
    </script>

    <script src="../js/footer.js"></script>
    <script src="../js/new_navbar.js"></script>
    <script src="../js/btnstyles.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>

</body>

</html>