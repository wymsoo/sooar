<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> New Purchase </title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link rel="stylesheet" href="../css/soarerbtn.css">
    <link rel="stylesheet" href="../css/popup_chat.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <style>
        form div {
            width: 80%
        }
    </style>
</head>

<body>

    <div id="newnav"></div>
    <div class="sep-bar-10"></div>
    <div id="popup_chat" style="display: none"></div>
    <div class="outer-circle animate bounce">
        <button class="inner-circle" onclick="gotochat()"></button>
    </div>
    <div class="block-container" style="margin-left: 20px; width: 90vw">
        <div>
            <div class="sep-bar-10"></div>
            <h1> 購買職涯發展顧問</h1>
            <div class="unlock">
                *在購買此項服務後，則可以到<a href="/f2fbooking">預約面談</a>頁面和導師預約時間。</div>
        </div>
    </div>


    <div id="newPurchaseForm" style="border: 2px solid black; border-radius: 5px; margin: 10px">
        <div class="content-container">
            <div style="display:flex; justify-content: space-between;">
                <div>
                    <h3>你的訂單</h3>
                </div>
                <!-- <div><button style="width:30px" onclick="toggleForm()">X</button></div> -->
            </div>
            <div class="sep-bar-10"></div>
            <div class="unlock"> 留意：請核對你所購入的服務編碼是否準確。</div>
            <div class="sep-bar-10"></div>

            <div id="registerInPurchase" class="content-container" style="display:none">
                <div>
                    <h4>你的個人資料</h4>
                </div>
                <div class="sep-bar-10"></div>
                <label style="color:grey;">學員全名<span class="text-danger">*</span></label>
                <input id="name" placeholder="Full Name" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">學員暱稱</label>
                <input id="nickname" placeholder="Nickname/ Preferred to be called as">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">出生年份<span class="text-danger">*</span></label>
                <input id="dob" placeholder="yyyy" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">聯絡電話<span class="text-danger">*</span></label>
                <input id="studentphone" placeholder="studentphone" required>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">電郵<span class="text-danger">*</span></label>
                <div class="main-container">
                    <input id="username" type="text" class="form-control" placeholder="e.g.johnchan123"
                        aria-label="Username" required>
                    <span class="input-group-text">@</span>
                    <input id="email" type="text" class="form-control" placeholder="gmail.com" aria-label="Email"
                        required>
                </div>
                <div class="sep-bar-10"></div>

                <label style="color:grey;">其他聯絡方式</label>
                <input id="otherContact" placeholder="e.g. WeChat: john24chan">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">喜好聯絡方式<span class="text-danger">*</span></label>
                <input id="contactMethod" placeholder="e.g. Whatsapp">
                <div class="sep-bar-10"></div>

                <label style="color:grey;">密碼<span class="text-danger">*</span></label>
                <input type="password" id="password" class="login-input" placeholder="Password" required>


                <label style="color:grey;">確認密碼<span class="text-danger">*</span></label>
                <input type="password" id="reconfirmpassword" placeholder="Password" required>
                <div class="sep-bar-10"></div>


            </div>


            <form>

                <label for="selectedCoach">1. 導師<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div>
                    <select id="selectedCoach" style="width: 100%" required>
                        <% coachlist.forEach((coach)=> { %>
                            <option value=<%=coach.username %>> <%= coach.nickname %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <label for="productname">2. 訂購服務<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div><select id="productname" style="width: 100%" required>
                        <option value="CC01"> 職涯發展面談(#CC01) $599</option>
                    </select>
                </div>

                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>



                <div class="sep-bar-10"></div>
                <label for="paymentmethod"> 4. 付款方式<span class="text-danger">*</span></label>
                <div>
                    <div class="sep-bar-10"></div><select id="paymentmethod" style="width: 100%" required>
                        <option value="single"> FPS </option>
                        <option value="set2"> Payme </option>
                        <option value="set3"> Alipay HK</option>
                    </select>
                </div>

                <div class="sep-bar-10"></div>
                <button class="mybtn-grid" onclick="initOrder(event)"> 購買 </button>
                <div class="sep-bar-10"></div>
                <div id="loading-msg" class="unlock" style="display:none"> Please wait, your purchase is processing...
                </div>
            </form>

        </div>
    </div>


    <button type="button" id="loading" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop"
        style="display:none"></button>

    <!-- Modal for loading -->
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">處理中...</h5>
                </div>
                <div class="modal-body">
                    我們正在處理您的訂單，請稍候... 請不要離開頁面。
                </div>
                <div class="modal-footer">
                    <button id="close" type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        style="display:none">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Asking user to register-->
    <!-- Button trigger modal -->
    <button type="button" id="goToRegister" class="btn btn-primary" data-bs-toggle="modal"
        data-bs-target="#registerModal" style="display:none"></button>

    <div class="modal fade" id="registerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">第一次購買顧問服務？</h5>
                </div>
                <div class="modal-body">
                    你是第一次購買顧問服務嗎？若果是第一次，我們會自動幫你註冊。若果你曾經購買過任何服務，你已經是我們的一份子了！請登入，讓我們為你更貼心地服務。
                </div>
                <div class="modal-footer">
                    <button id="loginnow" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        onclick="loginNow()">登入</button>
                    <button id="close" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        style="background-color: #D1B000; color: white">第一次購買</button>
                </div>
            </div>
        </div>
    </div>





    <script>

        function loginNow() {
            window.location.href = "/html/login.html"
        }


        function toggleForm() {
            $('#newPurchaseForm').hide();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var loginStatus = sessionStorage.getItem("login-status");
            if (loginStatus != 'true') {
                $('#registerInPurchase').show();
                $('#goToRegister').click();
                window.scrollTo(0, 0);
            } else {
                $('#newPurchaseForm').show();
            }
        })



        /* register function */
        function registerNewUser() {
            const email = $('#username').val() + '@' + $('#email').val();
            if ($('#password').val() != $('#reconfirmpassword').val()) {
                alert("Please reconfirm your pasword.");
                return false;
            }
            const data = {
                username: $('#username').val(),
                password: $('#password').val(),
                fullname: $('#name').val(),
                nickname: $('#nickname').val() || $('#name').val(),
                dob: $('#dob').val(),
                phone: $('#studentphone').val(),
                email: email,
                contactMethod: $('#contactMethod').val()
            };

            console.log(data);
            fetch('/auth/register', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => (res.json())).then(
                (data) => {
                    if (data.success) {
                        return true
                    } else {
                        alert(data.message);
                        throw new Error(data.message);
                    }
                }
            )
        };

        // end of register function 


        // login function
        function autoLogin() {
            const data = {
                username: $('#username').val(),
                password: $('#password').val()
            };
            console.log(data);
            fetch('/auth/login', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((login) => {
                if (login.status) {
                    sessionStorage.setItem('username', data.username);
                    sessionStorage.setItem('login-status', true);
                    if (sessionStorage.getItem('login-status') == true) {
                        sessionStorage.setItem('role', login.role);
                        alert(login.message)
                        return true
                    }
                } else {
                    alert(login.message);
                }
            }).catch((error) => console.error(error))
        }
        // end of login function


        // append a new purchase object to purchase array
        async function initOrder(e) {
            e.preventDefault();

            $(this).attr("disabled", "disabled");
            $('#loading').click();
            $('#loading-msg').show();

            if (sessionStorage.getItem('login-status') != 'true') {
                await registerNewUser();
                if (!registerNewUser) {
                    return
                }
                console.log("registered")
                await autoLogin();
            }


            const purchase = $('#productname').val();
            const instructor = $('#selectedCoach').val();
            const data = { purchase, instructor };

            await fetch('/purchase/newf2fOrder', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((data) => {
                if (data.success == true) {

                    $('#close').click();
                    $('#loading-msg').hide();
                    alert("Sucessfully Purchased.");
                    window.location.href = "/students/studentMeetings"
                } else {
                    $('#close').click();
                    $('#loading-msg').hide();
                    alert("Purchase unsuccessful");
                    window.location.href = "/students/f2fbooking"
                }
            }).catch((e) => console.error(e));
        }
    </script>

    <div id="footerHTML"></div>


    <script src="../js/footer.js"></script>
    <script src="../js/new_navbar.js"></script>
    <script src="../js/soarerbtn.js"></script>
    <script src="../js/popup_chat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>


</body>

</html>