<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Recording </title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/general.css">
    <link rel="stylesheet" href="/css/captureStyles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <style>
        .subcontainerbox-hor {
            margin-right: 10px;
            /* Space between the title and button */
            display: flex;
        }
    </style>

</head>

<body>
    <nav id="newnav"></nav>
    <div class="sep-bar-10"></div>
    <div class="sep-line"></div>


    <div class="content-container">
        <div style="font-weight: bold; font-size: 2em"> 錄像室</div>
    </div>

    <div class="fullwidth-container">
        <h2>球員資料</h2>
        <div>球員：<%= userid %>
        </div>
        <div>訂單編號：<%= purchaseid %>
        </div>
        <div>訂單日期：<%= purchasedate %>
        </div>
        <div> 影片：<br> <% video.path.forEach((vid)=> { %>
            <%= vid %> <br>
            <% }) %>
        </div>
        <div class="sep-bar-10"></div>
    </div>

    <div class="content-container">
        <h4>上載影片</h4>
        <input type="file" id="matchVideo" name="matchVideo" accept="video/*" />
        <div class="sep-bar-10"></div>
        <button class="mybtn-grid" style="width:30%" onclick="uploadVideo(event)">Upload Video</button>
        <div class="sep-bar-10"></div>
        <div class="sep-line"></div>
        <div class="sep-bar-10"></div>
        <h4> 錄製比賽影片旁述</h4>
        <button class="mybtn-grid" id="recordingToggle"
            style="background-color: rgb(153, 31, 31); color: white; width: 30%">
            Start Recording
        </button>
        <div class="sep-bar-10"></div>
        <!-- <button class="mybtn-grid" style="width:30%" onclick="openVideo('/playVideo?videopath=<%= video.path %>')">Video Tab</button> -->
         <% video.path.forEach((path)=>{ %>
          <button class="mybtn-grid" style="width:30%" onclick="openVideo('playVideo?videopath=<%= path %>')"><%= path %></button>
          <div class="sep-bar-10"></div>
        <% }) %>
    </div>
    <div class="content-container">
        <div class="subcontainerbox-hor">

            <video id="video" autoplay muted></video>
            <div class="volume-container">
                <div id="mic-visualizer" class="volume-visualizer"></div>
            </div>
            <div class="volume-container">
                <div id="desk-visualizer" class="volume-visualizer"></div>
            </div>
        </div>
    </div>

    <div class="content-container">
        <div style="visibility: hidden;" id="audioControls">
            <input type="range" id="micVolume" name="volume" min="0" max="1" step="0.05" value="1" />
            <label for="volume">Mic Volume</label>

            <input type="range" id="deskVolume" name="volume" min="0" max="1" step="0.05" value="0.2" />
            <label for="volume">Desktop Volume</label>

        </div>
    </div>

    <script>
        function openVideo(url) {
            window.open(url, "_blank").focus();
        }

        function uploadVideo(e){
                e.preventDefault()
                var input = document.querySelector('input[type="file"]');
                if (input==null){
                    alert('Please select a video.');
                    return
                }
                var data = new FormData();
                data.append('files', input.files[0]);
                const splitpath = '<%= video.path[0] %>'.split('-');
                const newpath = splitpath[0] + "-" + splitpath[1]
                console.log("newpath: ", newpath)

                fetch(`/instructors/uploadCommentaryVideo?videopath=${newpath}&user=<%= userid %>&purchaseid=<%= purchaseid %>`, {
                    method: "POST",
                    // headers: {
                    //     "Content-type": "multipart/form-data"
                    // },
                    body: data
                }).then((res) => res.json()).then((data) => {
                    if (data.success === true) {
                        alert(data.message);
                        window.location.href = "/";
                    } else {
                        alert("Upload unsuccessful");
                    }
                }).catch((e) => console.error(e));
        }
    </script>


</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script src="/js/screenRecord.js"></script>
<script src="/js/new_navbar.js"></script>
</body>

</html>