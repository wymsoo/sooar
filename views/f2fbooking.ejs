<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link rel="stylesheet" href="../css/soarerbtn.css">
    <link rel="stylesheet" href="../css/popup_chat.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <style>
        .hidden {
            display: none;
        }
    </style>
</head>

<body>

    <nav id="newnav"></nav>
    <div class="sep-bar-10"></div>
    <div id="popup_chat" style="display: none"></div>
    <div class="outer-circle animate bounce">
        <button class="inner-circle" onclick="gotochat()"></button>
    </div>



    <div id="meetingRequestForm" class="fullwidth-container mt-5" style="display: none">

        <div style="display:flex; justify-content: space-between">
            <h2> 預約表格</h2><button style="width: 30px" onclick="hideForm()">X</button>
        </div>
        <form id="requestForm">

            <div class="form-group">
                <label for="yourInstructor">導師</label>
                <input type="text" id="yourInstructor" value="instructor" readonly>
            </div>

            <div class="sep-bar-10"></div>

            <div class="form-group">
                <label for="yourMeetingDate">日期</label>
                <input type="text" id="yourMeetingDate" name="yourMeetingDate" value="00-00-00" readonly>
            </div>

            <div class="sep-bar-10"></div>


            <div class="form-goup">
                <label for="yourMeetingTimeslot">時段</label>
                <input type="text" id="yourMeetingTimeslot" name="yourMeetingTimeslot" value="00:00-00:00" readonly>
            </div>
            <div class="sep-bar-10"></div>

            <div class="form-roup">
                <label for="preferredTime">最適合你的時段</label>
                <input type="text" id="preferredTime" class="form-control" name="preferredTime"
                    placeholder="e.g. 15:30, 16:45">
            </div>
            <div class="sep-bar-10"></div>


            <div class="form-goup">
                <label>面談顧問類別</label>
                <div>
                    <div class="form-check">
                        <label class="form-check-label" for="generalConsultation">一般顧問</label>
                        <input class="form-check-input" type="radio" name="consultationType" id="generalConsultation"
                            value="general" checked>
                    </div>
                    <div class="form-check">
                        <label class="form-check-label" for="technicalConsultation">技術顧問</label>
                        <input class="form-check-input" type="radio" name="consultationType" id="technicalConsultation"
                            value="technical">
                    </div>
                </div>
            </div>
            <div class="sep-bar-10"></div>

            <div class="form-group">
                <label for="comments">對導師提出問題/補充</label>
                <textarea id="comments" class="form-control" rows="4" placeholder="提出3-5條想咨詢導師的問題。"></textarea>
            </div>


            <div class="sep-bar-10"></div>
            <% if (!user_session){ %>
            <button class="mybtn-grid" style="background-color: rgb(192, 191, 191); border-color: grey; color: black" disabled>你尚未登入</button>
            <% } else if (userinfo.zoom_quotas==0) { %>
                <button class="mybtn-grid" style="background-color: rgb(192, 191, 191); border-color: grey; color: black" disabled>你尚未購有任何面談服務</button>
            <% } else { %>
                <button class="mybtn-grid" onclick="submitForm(event)">提交</button>
            <% } %>
        </form>
    </div>


    <!-- Modal for Asking user to register-->
    <!-- Button trigger modal -->
    <button type="button" id="goToRegister" class="btn btn-primary" data-bs-toggle="modal"
        data-bs-target="#registerModal" style="display:none"></button>

    <div class="modal fade" id="registerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">第一次購買顧問服務？</h5>
                </div>
                <div class="modal-body">
                    你是第一次購買顧問服務嗎？若果是第一次，請你先購買<a href="f2fpurchase">技術面談</a>或<a href="/newpurchase"> 職涯發展面談服務 </a>！購買後，再在此網頁預約。若果不是第一次，請先登入。謝謝留意！
                </div>
                <div class="modal-footer">
                    <button id="loginnow" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        onclick="loginNow()">登入</button>
                    <button id="close" type="button" class="mybtn-grid btn-secondary" data-bs-dismiss="modal"
                        style="background-color: #b0b0b0; color: rgb(0, 0, 0)">關閉</button>
                </div>
            </div>
        </div>
    </div>
    </div>

    <div class="content-container">
        <div class="sep-bar-10"></div>
        <h1>預約與導師面談</h1>
        <div class="unlock">
            <% if(!user_session){ %>
                你尚未登入。若要預約面談，請<a href="/html/login.html">按此登入。</a>
           <% } else { %>
                你尚有<%= userinfo.zoom_quotas %>個未預約的面談服務。
            <% } %>
            <br>留意：填表格預約後，導師會在1-2日內Whatsapp聯絡閣下，確認面談日期和時間.
        </div>
    </div>

    <div class="content-container">
        <div class="container mt-5">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="instructorSelect">導師</label>
                    <select id="instructorSelect" class="form-control">
                        <option value="/">選擇導師</option>
                        <% slots.forEach((instructor)=>{ %>
                            <option value="<%=instructor.username%>">
                                <%= instructor.nickname %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="monthSelect">月份</label>
                    <select id="monthSelect" class="form-control">
                        <option value="">選擇月份</option>
                        <option value="January">January</option>
                        <option value="February">February</option>
                        <option value="March">March</option>
                        <option value="April">April</option>
                        <option value="May">May</option>
                        <option value="June">June</option>
                        <option value="July">July</option>
                        <option value="August">August</option>
                        <option value="September">September</option>
                        <option value="October">October</option>
                        <option value="November">November</option>
                        <option value="December">December</option>
                    </select>
                </div>
            </div>


            <table class="table">
                <thead>
                    <tr>
                        <th>導師</th>
                        <th>月份</th>
                        <th>日期</th>
                        <th>時段</th>
                        <th>預約</th>
                    </tr>
                </thead>
                <tbody id="tableBody">

                    <% slots.forEach(instructor=> {
                        console.log(instructor.username)
                        Object.keys(instructor.meetingslots).forEach((year)=>{
                        Object.keys(instructor.meetingslots[year]).forEach((month)=>{
                        Object.keys(instructor.meetingslots[year][month]).forEach((day) => {
                            const split = day.split('-');
                            const day1 = split[0] %>

                        <tr data-instructor="<%= instructor.username %>" data-month="<%= month %>">
                            <td>
                                <%= instructor.nickname %>
                            </td>
                            <td>
                                <%= month %>
                                    <% console.log(month) %>
                            </td>
                            <td>
                                <%= day1 %>-<%= month %>-<%= year %>
                            </td>
                            <td>
                                <%= instructor.meetingslots[year][month][day].start %> to <%=
                                        instructor.meetingslots[year][month][day].end %>
                            </td>
                            <td><button
                                    id="<%= instructor.username %>/<%= month %>/<%= day %>/<%= instructor.meetingslots[year][month][day].start %>/<%= instructor.meetingslots[year][month][day].end %>"
                                    class="mybtn-grid" onclick="reserveMeetingTime(this.id)">預約</button></td>
                        </tr>
                        <% }); }); });}); %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var loginStatus = sessionStorage.getItem("login-status");
            if (loginStatus != 'true') {
                $('#registerInPurchase').show();
                $('#goToRegister').click();
                window.scrollTo(0, 0);
            } else {
                $('#newPurchaseForm').show();
            }
        })




        /* register function */
        function registerNewUser() {
            const email = $('#username').val() + '@' + $('#email').val();
            if ($('#password').val() != $('#reconfirmpassword').val()) {
                alert("Please reconfirm your pasword.");
                return false;
            }
            const data = {
                username: $('#username').val(),
                password: $('#password').val(),
                fullname: $('#name').val(),
                nickname: $('#nickname').val() || $('#name').val(),
                dob: $('#dob').val(),
                phone: $('#studentphone').val(),
                email: email,
                contactMethod: $('#contactMethod').val()
            };


            fetch('/auth/register', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => (res.json())).then(
                (data) => {
                    if (data.success) {
                        return true
                    } else {
                        alert(data.message);
                        throw new Error(data.message);
                    }
                }
            )
        };

        // end of register function 


        // login function
        function autoLogin() {
            const data = {
                username: $('#username').val(),
                password: $('#password').val()
            };
            fetch('/auth/login', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((login) => {
                if (login.status) {
                    sessionStorage.setItem('username', data.username);
                    sessionStorage.setItem('login-status', true);
                    if (sessionStorage.getItem('login-status') == 'true') {
                        sessionStorage.setItem('role', login.role);
                        return true
                    }
                } else {
                    alert(login.message);
                }
            }).catch((error) => console.error(error))
        }
        // end of login function
    </script>





    <script>
        function loginNow() {
            window.location.href = "/html/login.html"
        }

        function hideForm() {
            $('#meetingRequestForm').hide()
        }

        function submitForm(e) {
            e.preventDefault();
            console.log(document.getElementById('yourInstructor').value)
            console.log($('#yourInstructor').val())


            const consultation_type = document.querySelector('input[name="consultationType"]:checked').value;
            const description = document.getElementById('comments').value;
            const instructor = $('#yourInstructor').val()
            const meetingdate = $('#yourMeetingDate').val()
            const preferred_meeting_time = $('#preferredTime').val()
            const timeslot = $('#yourMeetingTimeslot').val()
            var input = document.querySelector('input[type="file"]')

            var formdata = new FormData();
            formdata.append('description', description)
            formdata.append('meetingdate', meetingdate)
            formdata.append("preferred_meeting_time", preferred_meeting_time)
            formdata.append("timeslot", timeslot)
            formdata.append("consultation_type", consultation_type)
            formdata.append('instructor', instructor)

            fetch('/purchase/meetingRequest', {
                method: 'POST',
                body: formdata

            }).then(res => res.json()).then((data) => {
                if (data.success) {
                    alert(data.message);
                    window.location.href = "/students/studentMeetings";
                }
            }).catch(error => { console.error(error) })
        };

        function reserveMeetingTime(id) {

            const split = id.split('/');
            const instructor = split[0]
            const date = '2025-' + split[1] + '-' + split[2]
            const timeslot = split[3] + '-' + split[4]

            $('#yourInstructor').val(instructor);
            $('#yourMeetingDate').val(date);
            $('#yourMeetingTimeslot').val(timeslot);

            $('#meetingRequestForm').show()
            window.scrollTo(0, 0)

        };

        $(document).ready(function () {
            $('#instructorSelect, #monthSelect').change(function () {
                const selectedInstructor = $('#instructorSelect').val();
                const selectedMonth = $('#monthSelect').val();

                $('#tableBody tr').each(function () {
                    const instructor = $(this).data('instructor');
                    const month = $(this).data('month');

                    // const showRow = (!selectedInstructor || instructor === selectedInstructor) &&
                    //     (!selectedMonth || month === selectedMonth);
                    const showRow = (instructor === selectedInstructor) && (!selectedMonth) || ((month == selectedMonth) && (selectedInstructor == "/")) || ((instructor == selectedInstructor) && (month === selectedMonth))


                    $(this).toggle(showRow);
                });
            });
        });

        $(document).ready(function () {
            $(window).keydown(function (event) {
                if (event.keyCode == 13) {
                    // Check if the active element is not the textarea
                    if (event.target.id !== 'comments') {
                        event.preventDefault(); // Prevent default behavior if not in textarea
                        // Add your custom logic here if needed
                    }
                }
            });
        });
    </script>
    <div id="footerHTML"></div>


    <script src="../js/footer.js"></script>
    <script src="../js/new_navbar.js"></script>
    <script src="/js/soarerbtn.js"></script>
    <script src="../js/popup_chat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>

</body>

</html>