<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> f2f requests </title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>
    <nav id="newnav"></nav>


    <div class="fullwidth-container">
        <div class="content-container">
            <h1> 建議面談時間</h1>
        </div>
        <div class="content-container">
            <legend>更新時間方式</legend>
            <label>
                <input id="radio" type="radio" name="option" value="singleupdate" onclick="selectForm(this)"> Single
                Schedule Update
            </label>
            <label>
                <input id="radio" type="radio" name="option" value="weeklyupdate" onclick="selectForm(this)"> Weekly
                Schedule Update
            </label>
            <div class="sep-bar-10"></div>
            <div class="sep-line"></div>
            <div class="sep-bar-10"></div>
            <form id="availability-form">
                <fieldset id="singleupdate" style="display:none">
                    <legend>選擇日期</legend>
                    <label for="date">日期:</label>
                    <input type="date" id="available-date" name="available-date">
                </fieldset>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <fieldset id="weeklyupdate" style="display: none">
                    <legend>選擇星期（可多選）</legend>
                    <input type="month" id="selected-month" name="selected-month">
                    <div>
                        <label><input type="checkbox" name="day" value="1"> Monday</label>
                        <label><input type="checkbox" name="day" value="2"> Tuesday</label>
                        <label><input type="checkbox" name="day" value="3"> Wednesday</label>
                        <label><input type="checkbox" name="day" value="4"> Thursday</label>
                        <label><input type="checkbox" name="day" value="5"> Friday</label>
                        <label><input type="checkbox" name="day" value="6"> Saturday</label>
                        <label><input type="checkbox" name="day" value="0"> Sunday</label>
                    </div>
                </fieldset>
                <div class="sep-bar-10"></div>
                <div class="sep-line"></div>
                <div class="sep-bar-10"></div>
                <fieldset>
                    <legend> 選擇預約時段 </legend>
                    <label for="start-time">時段開始:</label>
                    <input type="time" id="start-time" name="start-time">
                    <label for="end-time">時段結束:</label>
                    <input type="time" id="end-time" name="end-time">
                    <div class="sep-bar-10"></div>
                </fieldset>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
                <div class="sep-line"></div>
                <div class="sep-bar-10"></div>
                <div class="sep-bar-10"></div>
            </form>
            <button class="mybtn-grid" type="button" onclick="addSlot(event)">Add Slot</button>
        </div>

    </div>
    <div class="fullwidth-container">
        <h3> 可預約面談時間 </h3>
        <div class="content-container" style="display: flex; justify-content: center">
            <div id="data-display"></div>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Month</th>
                        <th scope="col">Date</th>
                        <th scope="col">Time (start) </th>
                        <th scope="col">Time (end) </th>
                    </tr>
                </thead>
                <tbody>
                    <% var row=0 %>
                        <% Object.keys(coach_info).forEach((year)=>{
                            console.log(year)
                            Object.keys(coach_info[year]).forEach((month)=> {
                            console.log(month)
                            Object.keys(coach_info[year][month]).forEach((day)=>{
                            const split = day.split('-')
                            const day1 = split[0]
                            row = row + 1%>
                            <tr>
                                <th scope="row">
                                    <%= row %>
                                </th>
                                <td>
                                    <%= month %>
                                </td>
                                <td>
                                    <%= day1 %>
                                </td>
                                <td>
                                    <%= coach_info[year][month][day].start %>
                                </td>
                                <td>
                                    <%= coach_info[year][month][day].end %>
                                </td>
                                <td> <button id="<%= month %>-<%= day1 %>-<%= coach_info[year][month][day].start %>-<%= coach_info[year][month][day].end %>" class="mybtn-grid" style="background-color: rgb(151, 12, 12); color: white" onclick="deleteItem(this.id)">Delete</button> </td>
                            </tr>

                            <% })})}) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>

        function deleteItem(id){
            const split = id.split('-');
            const month = split[0];
            const day = split[1]+'-'+split[2];
            const start = split[2];
            const end = split[3];
            const data = {month, day, start, end}

            fetch(`/instructors/deleteMeetingTime`,{
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res)=>res.json()).then((data)=>{
                if (data.success){
                    alert("Successfully deleted.")
                    window.location.reload();
                }
            }).catch((e)=>console.error(e))
        }

        function selectForm(radio) {
            if (radio.value == "singleupdate") {
                $('#singleupdate').show()
                $('#weeklyupdate').hide()
            } else {
                $('#singleupdate').hide()
                $('#weeklyupdate').show()
            }
        }

        function addSlot(event) {
            event.preventDefault();
            const dateInput = document.getElementById('available-date').value; // Get the available date input
            console.log(dateInput)
            const startTimeInput = $('#start-time').val(); // Get the start time input
            const endTimeInput = $('#end-time').val(); // Get the end time input
            let data;
            const select = $('input[name="option"]:checked').val()
            console.log("RADIOOOOO: ",select)

            if (select == "weeklyupdate") {
                const dayInputsNode = document.querySelectorAll('input[name="day"]:checked'); // Get checked day inputs
                const dayInputs = Array.from(dayInputsNode).map(input => parseInt(input.value, 10)); // Convert NodeList to array of values
                console.log("Day inputs: ", dayInputs);

                const repeatInput = document.querySelector('input[name="repeat"]:checked'); // Get repeat option
                const suggestInput = document.querySelector('input[name="suggest-times"]:checked'); // Get suggestion option

                const select = $('#selected-month').val(); // Get the value of the input (month)
                const splitMonth = select.split('-'); // Split the string on '-'
                const selectedYear = parseInt(splitMonth[0], 10); // Parse year as an integer
                const selectedMonth = parseInt(splitMonth[1], 10) - 1; // Parse month and convert to zero-based index

                const firstday = 1;
                const newdate = new Date(selectedYear, selectedMonth, firstday); // Create date object for the first day of the month
                const firstweekday = newdate.getDay(); // Get the first weekday of the month

                // Calculate the last day of the month
                const lastdayofMonth = new Date(selectedYear, selectedMonth + 1, 0).getDate();
                console.log("First day of the month: ", firstweekday);

                let firstdates = {};
                // Calculate the first occurrence of each selected day in the month
                dayInputs.forEach((day) => {
                    const d = day - firstweekday; // Calculate the difference
                    if (d < 0) {
                        firstdates[day] = 7 + d + 1; // Adjust for negative values
                    } else {
                        firstdates[day] = d + 1; // Adjust for positive values
                    }
                });
                console.log("First occurrences of selected days: ", firstdates);

                const selectedDates = [];
                // Generate all occurrences of the selected days in the month
                Object.keys(firstdates).forEach(day => {
                    let dt = firstdates[day]; // Start from the first occurrence of the day
                    while (dt <= lastdayofMonth) {
                        selectedDates.push(dt); // Add the date to the selected dates array
                        dt += 7; // Move to the next occurrence of the same day
                    }
                });

                console.log("Selected Dates: ", selectedDates);


                data = {
                    year: selectedYear,
                    month: selectedMonth,
                    days: selectedDates,
                    startTime: startTimeInput,
                    endTime: endTimeInput
                };

                console.log(data)
            } else {
                const splitted = dateInput.split('-')
                const y = splitted[0]
                const m = splitted[1]
                const d = [parseInt(splitted[2])]
                data = {
                    year: y,
                    month: m,
                    days: d,
                    startTime: startTimeInput,
                    endTime: endTimeInput
                }
                console.log(data)
            }
                  
            fetch('/instructors/addPreferredMeetingDates', {
                method: "POST",
                headers: {
                    "Content-type": "application/json"
                },
                body: JSON.stringify(data)
            }).then((res) => res.json()).then((data) => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                }
            }).catch((e) => console.error(e));
        }

    </script>





    <div id="footerHTML"></div>


    <script src="../js/footer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>
    <script src="../js/new_navbar.js"></script>
</body>

</html>