<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="../css/navbar.css">
    <link rel="stylesheet" href="../css/general.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mogra&family=Noto+Sans+TC:wght@100..900&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>
<body>

    <div id="newnav"></div>
    <div class="sep-bar-10"></div>
    <div class="sep-bar-10"></div>

    <div class="block-container" style="margin-left: 20px; width: 90vw">
        <div>
            <h1> 你的面談預約</h1>
        </div>
        <div class="unlock">提交預約表格請<a href="/students/f2fbooking">按此</a>。在和導師Whatsapp約實時間後，導師會在面談時間前發送Zoom Link給你。若果還未下載Zoom，請提早按此下載：<a href="https://support.zoom.com/hc/zt/article?id=zm_kb&sysparm_article=KB0060936#h_01FNVWMCWV1Y2E3ZPSCQYFS2FH">下載Zoom(電腦版本)</a>
        或<a href="https://zoom.us/download">下載iOS應用程式</a>。</div>
    </div>

    <div class="fullwidth-container">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>預約編號</th>
                    <th>導師</th>
                    <th>日期</th>
                    <th>時間</th>
                    <th>狀態</th>
                </tr>
            </thead>
            <tbody>
                <% Object.keys(meetings).forEach((appointment)=>{ %>
                <tr>
                    <td><%= appointment %></td>
                    <td><%= meetings[appointment].instructor %></td>
                    <% const split = meetings[appointment].meetingdate.split('-')
                       const date = split[0]+'-'+split[1]+'-'+split[2]; %>
                    <td><%= date %></td>
                    <td><%= meetings[appointment].preferred_meeting_time %></td>
                    <% if (meetings[appointment].resolved == "unresolved") { %>
                    <td> 待定 </td>
                    <% } else if (meetings[appointment].resolved == "pending"){ %>
                    <td> 已確認時間 </td>
                    <% } else { %>
                    <td style="color: green"> 已完成 </td>
                    <% } %>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script src="../js/new_navbar.js"></script>
    <script src="../js/btnstyles.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
        crossorigin="anonymous"></script>
    
</body>
</html>
    