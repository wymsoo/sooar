PORT=8080
SESSION_SECRET=replace-with-a-long-random-value

# Gmail OAuth2 / Nodemailer
CLIENT_ID=replace-with-gmail-oauth-client-id
CLIENT_SECRET=replace-with-gmail-oauth-client-secret
REDIRECT_URI=https://developers.google.com/oauthplayground
REFRESH_TOKEN=replace-with-gmail-refresh-token

# DeepSeek
DEEPSEEK_KEY=replace-with-deepseek-api-key

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key

# Google Gmail browser quickstart (public values, still configure via environment)
GOOGLE_CLIENT_ID=replace-with-browser-oauth-client-id
GOOGLE_API_KEY=replace-with-google-api-key
